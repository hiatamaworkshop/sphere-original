# Sphere Project - Environment Variables
# Copy this file to .env and customize as needed

# PostgreSQL
POSTGRES_PASSWORD=sphere_dev_password

# MinIO
MINIO_ROOT_USER=sphere_admin
MINIO_ROOT_PASSWORD=sphere_admin_password

# Node Environment
NODE_ENV=development

# Digestor Storage Backend ("file" or "turso")
STORAGE_BACKEND=file

# RefDB Backend ("map" or "turso")
REFDB_BACKEND=map

# Turso (shared by Digestor + Periphery when backend=turso)
TURSO_URL=
TURSO_AUTH_TOKEN=
