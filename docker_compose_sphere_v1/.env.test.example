# テスト/回帰確認用の設定。
#
# デフォルトの .env は REFDB_BACKEND=turso / STORAGE_BACKEND=turso で、
# 本番の Turso に write-through で書き込む。dive の evaluate や move が
# そのまま本番データを汚すため、動作確認だけしたいときはこちらを使う。
#
# 使い方:
#   cp .env.test.example .env.test
#   docker compose --env-file .env.test up -d
#
# TURSO_URL / TURSO_AUTH_TOKEN は map/file backend では読まれないため不要。

POSTGRES_PASSWORD=sphere_dev_password
MINIO_ROOT_USER=sphere_admin
MINIO_ROOT_PASSWORD=sphere_admin_password
NODE_ENV=development

# 本番 Turso に触らない安全な組み合わせ
STORAGE_BACKEND=file
REFDB_BACKEND=map
